PORT=3000
# Utilisé par sequelize-cli / npm en LOCAL (Windows). MariaDB doit tourner (docker compose up) avec le port 3306 exposé.
# Sous Docker, docker-compose.yml force DB_HOST=app-assurmoi-db pour le service Node (prioritaire sur ce fichier).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=assurmoidb
DB_USERNAME=root
DB_PASSWORD=root
DB_SSL=false
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h